[Bb]in/
[Oo]bj/
[Ll]ibrary/
x64/
x86/
*.tlog
*.log
*.cache
*.ilk
MSBuildOutput.txt

# ---------------------------------------------------------------
# Visual Studio / IDE
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.userprefs
*.DotSettings.user
*.sln.docstates
*.VC.db
*.VC.VC.opendb
