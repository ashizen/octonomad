# ---------------------------------------------------------------
# Release binaries
# These belong on the GitHub Releases page, not in git history.
# ---------------------------------------------------------------
*.exe
*.dll
*.pdb
*.so
*.dylib
*.apk
*.aab
*.aar
*.ipa

# ---------------------------------------------------------------
# Android / Gradle (for when the mobile project lands here)
# Unity .meta files are intentionally NOT ignored - they must be committed.
# ---------------------------------------------------------------
.gradle/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/
*.keystore
*.jks
*.p12
*.pfx

# ---------------------------------------------------------------
# OS junk
# ---------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*

# ---------------------------------------------------------------
# Release asset staging
# The folder itself is tracked (via Releases/README.md) but whatever
# binaries you drop in it are not. Publish them at:
#   https://github.com/ashizen/octonomad/releases
# ---------------------------------------------------------------
/Releases/*
!/Releases/README.md
